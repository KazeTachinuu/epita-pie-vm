#!/bin/sh
# afs [login]: your EPITA password -> kinit ticket -> ssh GSSAPI to the gate ->
# sshfs mount -> apply your .confs. The password is never stored.
set -eu
gui()  { [ -n "${DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1; }
note() { if gui; then zenity --"$1" --title="EPITA AFS" --width=340 --text="$2" 2>/dev/null & else echo "afs: $2" >&2; fi; }

mountpoint -q "$HOME/afs" 2>/dev/null && { echo "afs: already mounted"; exit 0; }
login="${1:-}"

# get a Kerberos ticket; retry up to 3x (more risks locking the account)
tries=0; hint="Connect your AFS"
while :; do
  if gui && [ -n "$login" ]; then
    pass=$(zenity --password --title="EPITA AFS ($login)" --width=320 2>/dev/null) || exit 0
  elif gui; then
    f=$(zenity --forms --title="EPITA AFS" --text="$hint" --add-entry="Login" \
        --add-password="Password" --separator="/" --width=320 2>/dev/null) || exit 0
    login=${f%%/*}; pass=${f#*/}
  else
    [ -n "$login" ] || { printf "login: "; read -r login; }
    stty -echo 2>/dev/null || true; printf "password: "; read -r pass
    stty echo 2>/dev/null || true; echo
  fi
  [ -n "$login" ] && [ -n "$pass" ] || exit 0
  kmsg=$(printf '%s' "$pass" | kinit -f "$login@CRI.EPITA.FR" 2>&1) && { unset pass; break; }
  unset pass; tries=$((tries + 1)); login=
  [ "$tries" -ge 3 ] && { note error "Login failed: ${kmsg:-wrong login or password}"; exit 1; }
  hint="Login failed, try again"
done

[ -L "$HOME/afs" ] && rm "$HOME/afs"
mkdir -p "$HOME/afs"
l1=$(printf %.1s "$login"); l2=$(printf %.2s "$login")
# command -v ssh resolves the base's openssh-with-gssapi. The container has no
# /etc/ssh/ssh_config, so GSSAPI is off by default and the gate denies us
# ("Permission denied (...gssapi...)"); enable it explicitly and delegate creds for
# AFS. known_hosts goes to /tmp since ssh uses root's home, which is unwritable.
log=$(mktemp)
sshfs -o reconnect,StrictHostKeyChecking=accept-new,ConnectTimeout=15 \
    -o kernel_cache,auto_cache,attr_timeout=3600,entry_timeout=3600 \
    -o ssh_command="$(command -v ssh) -o GSSAPIAuthentication=yes -o GSSAPIDelegateCredentials=yes -o UserKnownHostsFile=/tmp/pie-known-hosts" \
    "$login@ssh.cri.epita.fr:/afs/cri.epita.fr/user/$l1/$l2/$login/u/" "$HOME/afs" 2>"$log" &
sp=$!
if gui; then
  ( while kill -0 "$sp" 2>/dev/null; do printf '\n'; sleep 1; done ) \
      | zenity --progress --pulsate --auto-close --no-cancel --title="EPITA AFS" \
          --text="Connecting to AFS..." --width=320 2>/dev/null &
fi
wait "$sp" 2>/dev/null || true
msg=$(cat "$log" 2>/dev/null || true); rm -f "$log"

mountpoint -q "$HOME/afs" 2>/dev/null || { note error "Could not mount AFS: ${msg:-unknown error}"; exit 1; }
[ -d "$HOME/afs/.confs" ] && find "$HOME/afs/.confs" -type f \
    -not -path '*/.git/*' -not -path '*/undo/*' -not -name '.new.*' \
    -exec cat {} + >/dev/null 2>&1 &
[ -x "$HOME/afs/.confs/install.sh" ] && AFS_DIR="$HOME/afs" "$HOME/afs/.confs/install.sh" >/dev/null 2>&1 || true
note info "AFS connected. Open a new terminal for your setup."
