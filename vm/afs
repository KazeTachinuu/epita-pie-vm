#!/bin/sh
# afs [login]: kinit -> GSSAPI ssh gate -> sshfs mount of your AFS -> apply
# your .confs. The password is never stored.
# afs off: drop the mount (also clears a stuck one). AFS_DEBUG=1: trace.
# On a tty: marker output, no popups. No tty (dmenu, keybind): zenity.
set -eu
[ -z "${AFS_DEBUG:-}" ] || set -x

MP="$HOME/afs"

# [+] step done  [=] already converged  [!] warning  [x] fatal
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ]; then
    G='\033[1;32m' R='\033[31m' Y='\033[33m' D='\033[2m' N='\033[0m'
else
    G='' R='' Y='' D='' N=''
fi
ok()   { printf "${G}[+]${N} %s\n" "$1"; }
skip() { printf "${D}[=] %s${N}\n" "$1"; }
warn() { printf "${Y}[!]${N} %s\n" "$1" >&2; }
fail() { printf "${R}[x]${N} %s\n" "$1" >&2; }
TOTAL=3 STEP=0
step() { STEP=$((STEP + 1)); ok "[$STEP/$TOTAL] $1"; }

gui() { [ ! -t 1 ] && [ -n "${DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1; }
# blocking: an error dialog the script exits right after must be seen
note() {
  if gui; then zenity --"$1" --title="EPITA AFS" --width=340 --text="$2" 2>/dev/null || true
  elif [ "$1" = error ]; then fail "$2"
  else ok "$2"; fi
}
# /proc/mounts, not mountpoint(1): stat() on a hung FUSE mount blocks forever
mounted() { grep -qsF " $MP fuse" /proc/mounts; }
# clear a dead or hung mount: lazy unmount (a plain -u fails EBUSY while
# requests hang on it), then kill its sshfs. With -o reconnect that process
# outlives the dropped link and expired ticket, and would keep the mountpoint
# wedged under the new mount.
unmount() {
  timeout 5 fusermount3 -uz "$MP" 2>/dev/null \
    || timeout 5 fusermount -uz "$MP" 2>/dev/null || true
  pkill -f "sshfs .* $MP\$" 2>/dev/null || true
}

# kinit's answer in plain words; status 2: retrying cannot help
kwhy() {
  case "$1" in
    *"Password incorrect"*|*"Preauthentication failed"*) echo "wrong password" ;;
    *"not found in Kerberos database"*) echo "unknown login (expected: firstname.lastname)" ;;
    *revoked*) echo "account locked by EPITA: wait a few minutes"; return 2 ;;
    *"Clock skew"*) echo "the VM clock is wrong: reboot the VM"; return 2 ;;
    ""|*"Cannot contact"*|*"Cannot find KDC"*|*resolve*|*"Network is unreachable"*)
      echo "cannot reach EPITA: check the VM network"; return 2 ;;
    *) echo "${1#kinit: }" ;;
  esac
}
# sshfs's answer in plain words
mwhy() {
  case "$1" in
    *"Permission denied"*) echo "the EPITA gate refused your login" ;;
    *"No such file"*) echo "no AFS home found for $login" ;;
    *"timed out"*|*refused*|*"Could not resolve"*|*unreachable*|*"No route"*)
      echo "cannot reach ssh.cri.epita.fr: check the VM network" ;;
    "") echo "unknown error" ;;
    *) echo "$1" ;;
  esac
}

if [ "${1:-}" = off ]; then unmount; ok "AFS disconnected"; exit 0; fi

# live mount -> done; stale endpoint from a dropped link -> clear and remount
if mounted; then
  if timeout 5 ls "$MP" >/dev/null 2>&1; then skip "already mounted at ~/afs"; exit 0; fi
  unmount
fi

login="${1:-}"
login=$(printf %s "$login" | tr '[:upper:]' '[:lower:]'); login=${login%%@*}

# a still-valid forwardable ticket (afs off, then afs): no password needed
# (|| true: no ticket fails klist, which pipefail turns into an exit)
have=$(klist 2>/dev/null | sed -n 's/^Default principal: \(.*\)@CRI\.EPITA\.FR$/\1/p') || true
if [ -n "$have" ] && { [ -z "$login" ] || [ "$login" = "$have" ]; } \
   && klist -s 2>/dev/null && klist -f 2>/dev/null | grep -q 'Flags: .*F'; then
  login=$have
  step "Kerberos ticket for $login (still valid)"
else
# Kerberos ticket; 3 tries max (more risks locking the account)
tries=0; hint="Connect your AFS"
while :; do
  if gui && [ -n "$login" ]; then
    pass=$(zenity --password --title="EPITA AFS ($login)" --width=320 2>/dev/null) || exit 0
  elif gui; then
    f=$(zenity --forms --title="EPITA AFS" --text="$hint" --add-entry="Login" \
        --add-password="Password" --separator="/" --width=320 2>/dev/null) || exit 0
    login=${f%%/*}; pass=${f#*/}
  else
    [ -n "$login" ] || { printf "login: "; read -r login; }
    trap 'stty echo 2>/dev/null || true' EXIT INT TERM
    stty -echo 2>/dev/null || true; printf "password: "; IFS= read -r pass
    stty echo 2>/dev/null || true; trap - EXIT INT TERM; echo
  fi
  # accept "Prenom.Nom@epita.fr"
  login=$(printf %s "$login" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
  login=${login%%@*}
  [ -n "$login" ] && [ -n "$pass" ] || exit 0
  kmsg=$(printf '%s' "$pass" | timeout 25 kinit -f "$login@CRI.EPITA.FR" 2>&1) \
    && { unset pass; break; }
  unset pass; tries=$((tries + 1)); login=
  why=$(kwhy "$kmsg") || { note error "Login failed: $why"; exit 1; }
  [ "$tries" -ge 3 ] && { note error "Login failed: $why"; exit 1; }
  gui || fail "$why ($((3 - tries)) tries left)"
  hint="Login failed: $why ($((3 - tries)) tries left)"
done
step "Kerberos ticket for $login"
fi

[ -L "$MP" ] && rm -f "$MP"
mkdir -p "$MP"
l1=$(printf %.1s "$login"); l2=$(printf %.2s "$login")

# GUI: one progress window, label follows the stages (fifo on fd 3).
# Terminal: numbered step line before each stage.
pfifo="" tick="" mpid=""
# on any exit (incl. Ctrl-C): stop the counter and a pending mount
cleanup() {
  [ -z "$mpid" ] || kill "$mpid" 2>/dev/null
  [ -z "$tick" ] || { kill "$tick" 2>/dev/null; printf '\n'; }
  [ -z "$pfifo" ] || rm -f "$pfifo"
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP
if gui; then
  pfifo=$(mktemp -u)
  mkfifo "$pfifo"
  zenity --progress --pulsate --no-cancel --auto-close --title="EPITA AFS" \
      --text="Connecting to AFS..." --width=340 <"$pfifo" 2>/dev/null &
  exec 3<>"$pfifo"
fi
# stage: numbered step with a live elapsed counter, honest liveness without a
# fake ETA (mount time is network-bound and unpredictable). stage_done stops it.
stage() {
  if [ -n "$pfifo" ]; then printf '# %s\n' "$1" >&3 2>/dev/null || true; return 0; fi
  STEP=$((STEP + 1))
  printf "${G}[+]${N} [%s/%s] %s" "$STEP" "$TOTAL" "$1"
  if [ -t 1 ]; then
    ( t=0; while sleep 1; do t=$((t + 1))
        printf "\r${G}[+]${N} [%s/%s] %s ${D}(%ss)${N}" "$STEP" "$TOTAL" "$1" "$t"
      done ) & tick=$!
  else
    printf '\n'
  fi
}
stage_done() {
  [ -z "$tick" ] || { kill "$tick" 2>/dev/null; wait "$tick" 2>/dev/null || true
                      tick=""; printf '\n'; }
}
pdone() { stage_done
          if [ -n "$pfifo" ]; then printf '100\n' >&3 2>/dev/null || true
          exec 3>&-; rm -f "$pfifo"; pfifo=""; fi; }

# auto_cache, never kernel_cache: AFS changes externally and kernel_cache would
# serve stale data. known_hosts -> /tmp: ssh's HOME is unwritable on the PIE.
# BatchMode: if the ticket is refused, fail now instead of ssh waiting on a
# password prompt nobody sees (that hang ends in timeout's SIGTERM, reported
# by sshfs as "read: Interrupted system call").
SSH="$(command -v ssh) -o BatchMode=yes -o GSSAPIAuthentication=yes -o GSSAPIDelegateCredentials=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o UserKnownHostsFile=/tmp/pie-known-hosts"
stage "mounting AFS via ssh.cri.epita.fr"
# two tries: after a long idle or a host suspend the first connection can stall
for try in 1 2; do
  log=$(mktemp); rc=0
  # background + wait: Ctrl-C never reaches timeout's process group
  timeout 60 sshfs \
      -o reconnect,StrictHostKeyChecking=accept-new,ConnectTimeout=15 \
      -o auto_cache \
      -o ssh_command="$SSH" \
      "$login@ssh.cri.epita.fr:/afs/cri.epita.fr/user/$l1/$l2/$login/u/" "$MP" 2>"$log" &
  mpid=$!
  wait "$mpid" || rc=$?
  mpid=""
  msg=$(cat "$log" 2>/dev/null || true); rm -f "$log"
  [ "$rc" -eq 124 ] && msg="timed out reaching ssh.cri.epita.fr (network down?)"
  # trust the actual mount state, not sshfs's exit code
  mounted && break
  unmount
  if [ "$try" -eq 2 ]; then
    # sshfs reports every ssh failure as "Connection reset by peer"; ask ssh
    # itself (network? refused?); if ssh works, the problem is the AFS path
    # shellcheck disable=SC2086
    probe=$(timeout 25 $SSH -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new \
              "$login@ssh.cri.epita.fr" true 2>&1 </dev/null) && probe=""
    pdone; note error "Could not mount AFS: $(mwhy "$probe$msg")"; exit 1
  fi
done
stage_done

# usable now; the configs below only matter for new terminals
gui || ok "AFS ready at ~/afs: you can start working"

# apply the configs (same install.sh as campus), then warm their files in the
# background: read one by one, each file is a round trip to the gate (minutes
# for a big .confs); 16 at a time and detached, nobody waits for it
applied=1
if [ -x "$MP/.confs/install.sh" ]; then
  stage "applying your configs"
  irc=0; timeout 60 env AFS_DIR="$MP" "$MP/.confs/install.sh" >/dev/null 2>&1 || irc=$?
  stage_done
  [ "$irc" -eq 0 ] || { applied=0
    warn "your .confs/install.sh failed (exit $irc); AFS stays mounted"; }
else
  [ -n "$pfifo" ] || skip "no install.sh, nothing to apply"
fi
pdone
[ ! -d "$MP/.confs" ] || setsid sh -c 'find "$1" -type f -not -path "*/.git/*" -not -path "*/undo/*" \
    -not -name ".new.*" -print0 | timeout 300 xargs -0 -P 16 -n 16 cat' _ "$MP/.confs" \
    >/dev/null 2>&1 </dev/null &

if gui; then
  [ "$applied" -eq 1 ] && msg="Your configs are applied: open a new terminal." \
    || msg="Your .confs/install.sh failed (exit $irc)."
  zenity --info --timeout=10 --title="EPITA AFS" --width=340 \
      --text="AFS connected at ~/afs: you can start working.\n$msg" 2>/dev/null || true
else
  [ "$applied" -eq 0 ] || ok "configs applied: open a new terminal for your setup"
fi
